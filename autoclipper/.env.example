# Copy to .env and `chmod 600 .env`. Never commit .env.

# Dashboard login (required)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# Optional: Twitch Helix app credentials (free, https://dev.twitch.tv/console).
# Faster live checks for many streamers + real stream start time for VOD timestamps.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public HTTPS address of this server. Needed for the YouTube/TikTok "Connect" logins
# (OAuth redirect) and for Buffer/Instagram, which download the video from it.
PUBLIC_BASE_URL=

# Encryption key for stored tokens/credentials. Optional: if empty, a key is generated once
# in data/secrets/master.key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOCLIPPER_SECRET_KEY=

# Everything below can ALSO be entered in the dashboard's Setup wizard (stored encrypted).
# Values set here take precedence.

# YouTube: OAuth client (Web application). Channels are connected with the "Connect YouTube" button.
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# TikTok: app with Login Kit + Content Posting API. Accounts connect with "Connect TikTok".
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Buffer (free plan includes the API): publish.buffer.com/settings/api
BUFFER_API_KEY=

# Upload-Post (paid for TikTok): optional
UPLOADPOST_API_KEY=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram Graph API version/host (Instagram accounts are added in the dashboard)
IG_API_VERSION=v27.0
IG_GRAPH_HOST=graph.instagram.com
