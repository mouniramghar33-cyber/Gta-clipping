# Copy to .env and `chmod 600 .env`. Never commit .env.

# Dashboard login (required)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# Optional: Twitch Helix app credentials (free, https://dev.twitch.tv/console).
# Faster live checks for many streamers + real stream start time for VOD timestamps.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public HTTPS address of this server (needed only for Instagram, which downloads the video).
PUBLIC_BASE_URL=

# YouTube Shorts (YouTube Data API v3, scope youtube.upload)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# TikTok Content Posting API (scope video.publish). Refresh tokens rotate; the newest is
# stored automatically in data/secrets/tokens.json.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Instagram Reels (Instagram API with Instagram Login)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v27.0
IG_GRAPH_HOST=graph.instagram.com
